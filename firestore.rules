rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 공통 헬퍼 =====
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'dyrhl4321@gmail.com';
    }
    // 문서에 저장된 작성자(userId) 본인 여부
    function ownsDoc() {
      return request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ===== 유저 프로필 (사진/닉네임 공개 읽기 필요) =====
    match /users/{userId} {
      // ★users 읽기 조이기를 두 번 시도했다가 **두 번 다 되돌렸다** (2026-08-25). 기록으로 남긴다.
      //   ① `read: if signedIn()` → 비가입자 화면에서 이름을 못 읽어 **전부 '머피'로** 떴다
      //   ② `get: true / list: signedIn()` → 인기 캐릭터·인기 룸이 **컬렉션을 통째로 받아
      //      정렬하는 방식**이라 그것까지 같이 죽었다
      //   대표 판단: 비가입자에게 지도·인기 캐릭터·인기 룸이 보여야 한다. 빈 화면을 보면
      //   가입 전에 그냥 나간다 — 콜드스타트가 보안보다 먼저다.
      //
      // ※그래서 지금은 **열어 둔다.** 남은 노출: 생년월일·성별·지역·다니는 헬스장·FCM 토큰.
      //   제대로 된 해결은 규칙이 아니라 **데이터를 나누는 것**이다:
      //     - 공개용 미러 문서(닉네임·캐릭터·방 썸네일)를 따로 두고 그걸 공개로 열기
      //     - 민감 필드는 users/{uid}/private/ 로 옮기기 (규칙은 아래에 이미 깔아 뒀다)
      //   앱 코드를 같이 고쳐야 하는 일이라 별도 작업으로 잡는다.
      allow read: if true;

      // 민감 정보는 여기로 옮긴다(본인만 읽고 쓴다). 아직 앱이 안 쓰지만 규칙을 먼저 깔아 둔다.
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
      // ★관리자 쓰기 (2026-08-14) — 대표가 특정 계정에 머피를 넣어줘야 한다(베타 보상·이벤트).
      //   isAdmin() 은 대표 이메일 하나로 고정돼 있다(파일 위쪽 헬퍼).
      allow create: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      // ★크레딧 증가폭 제한 (2026-08-25).
      //   지금까지 본인은 자기 문서의 **아무 필드나** 쓸 수 있었다. 브라우저 콘솔 한 줄이면
      //   자기 머피를 100만으로 만들 수 있었다는 뜻이다(경제가 클라이언트 신뢰에 100% 의존).
      //   한 번에 1000 초과 증가를 거부한다. 반복하면 뚫리므로 **근본 해결이 아니다** —
      //   진짜 해결은 크레딧 지급을 Cloud Functions 로 옮기는 것이다(CLAUDE.md '공개 런칭 전 필수').
      //   1000 으로 잡은 이유: 도감 보너스처럼 한 번에 여러 건을 몰아 주는 지급이 있어서
      //   너무 좁게 잡으면 정상 적립이 막힌다. 좁히려면 그 지급들을 먼저 쪼개야 한다.
      allow update: if isAdmin() || (isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits'])
          || request.resource.data.credits <= resource.data.credits + 1000
      ));

      // 머피월드 방명록 (싸이월드식) — 작성자=본인 서명, 삭제=방주인/작성자
      match /guestbook/{entryId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.from == request.auth.uid;
        allow delete: if isOwner(userId) || (signedIn() && resource.data.from == request.auth.uid);
      }
      // 방 방문 카운터 (TODAY) — 방문자가 increment
      match /roomstat/{dayId} {
        allow read: if true;
        allow write: if signedIn();
        // 하루 1회 판정용 방문 표식. 이게 없으면 방을 열 때마다 TODAY 가 올라간다.
        // ★자기 표식만 만들 수 있고(위조 방지), 읽기는 방 주인과 본인만 —
        //   전체 공개로 두면 누가 누구 방에 갔는지 아무나 훑을 수 있다.
        match /visitors/{visitorId} {
          allow read: if isOwner(userId) || isOwner(visitorId);
          allow create: if isOwner(visitorId);
        }
      }
      // 캐릭터/방 좋아요. kind = 'char' | 'room'
      // ★카운터를 users/{userId} 본문에 못 둔다 — 그 문서는 본인만 쓸 수 있어서(위 write 규칙)
      //   남이 누른 좋아요를 반영할 수가 없다. 그래서 하위 컬렉션에 센다.
      match /likestat/{kind} {
        allow read: if true;
        allow write: if signedIn();
        // 누가 눌렀는지 — 토글용. 자기 표식만 만들고 지울 수 있다(남의 좋아요 취소 방지)
        match /by/{fromId} {
          allow read: if true;
          // active 토글 문서를 지우지 않고 rewarded=true 지급 원장으로 남긴다.
          // 본인 표식만 수정 가능해야 남이 내 좋아요/보상 기록을 바꾸지 못한다.
          allow create, update, delete: if isOwner(fromId);
        }
      }
    }

    // ===== 피드 =====
    match /feed/{postId} {
      allow read: if true;
      allow create: if signedIn();
      // ★2026-08-25 — 예전엔 `allow update: if signedIn()` 이었다. 좋아요 카운터 때문에 열어둔
      //   것인데 **필드 제한이 없어서 아무나 남의 인증글 내용을 통째로 바꿀 수 있었다.**
      //   작성자·관리자는 전부, 남은 카운터와 신고 표시만 건드린다.
      //   ※여기 목록에 없는 필드를 앱이 남의 글에 쓰기 시작하면 그 기능이 조용히 막힌다 —
      //     새 필드를 추가할 때 이 줄을 같이 고칠 것.
      allow update: if ownsDoc() || isAdmin()
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likes', 'likedBy', 'commentCount', 'reportedBy']));
      // 삭제는 작성자 본인 또는 관리자만
      allow delete: if ownsDoc() || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn();
        // 신고 표시(reportedBy)는 비작성자도 남겨야 한다. 대신 **그 필드만** 열어 준다.
        allow update: if ownsDoc() || isAdmin()
          || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['likes', 'likedBy', 'reportedBy']));
        allow delete: if ownsDoc() || isAdmin();
      }
    }

    // ===== 대숲 =====
    match /bamboo/{postId} {
      allow read: if true;
      allow create: if signedIn();
      // ★2026-08-25 — feed 와 같은 구멍이었다. 로그인만 하면 남의 대숲 글을 통째로 바꿀 수 있었다.
      //   실제로 남이 쓰는 필드는 좋아요(likes/likedBy)·댓글수·신고 표시뿐이다(코드 확인).
      //   '저에요' 신청은 이 문서가 아니라 chats 로 간다.
      allow update: if ownsDoc() || isAdmin()
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likes', 'likedBy', 'commentCount', 'reportedBy']));
      allow delete: if ownsDoc() || isAdmin();

      // 익명 댓글
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn();
        // 신고 표시(reportedBy) — 대숲 글(bamboo)과 같은 수준으로 연다
        // 신고 표시만 비작성자에게 연다(글과 같은 규칙)
        allow update: if ownsDoc() || isAdmin()
          || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['likes', 'likedBy', 'reportedBy']));
        allow delete: if ownsDoc() || isAdmin();
      }
    }

    // ===== 좋아요(매칭 신청) =====
    match /likes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      // 같은 사람에게 다시 눌러도 setDoc이 update로 판정됨 → 본인이 보낸 건만 허용(재전송 idempotent)
      allow update: if signedIn() && resource.data.from == request.auth.uid && request.resource.data.from == request.auth.uid;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // ===== 매칭 =====
    match /matches/{matchId} {
      allow read: if signedIn();
      // ★2026-08-25 — `write: if signedIn()` 이라 **아무나 남의 매칭을 만들거나 지울 수** 있었다.
      //   문서는 { users: [a, b] } 이고 id 는 _pairKey(a,b) 다(코드 확인). 당사자만 손댄다.
      allow create: if signedIn() && request.auth.uid in request.resource.data.users;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // ===== 차단 (2026-08-14, 애플 심사 1.2) =====
    // 문서 ID = `차단한사람_차단당한사람` → 서로 차단하면 문서가 2개가 되고 각자 자기 것만 지운다.
    // users 배열은 matches 와 **같은 모양**이라 앱은 `array-contains 나` 한 번으로
    // '내가 차단한 사람'과 '나를 차단한 사람'을 같이 받는다(= 양방향 차단).
    // ★읽기를 `나도 users 안에 있을 때`로 좁힌다 — signedIn() 으로 열면 남의 차단 관계를
    //   전부 훑을 수 있다. array-contains 쿼리는 이 조건을 만족하는 문서만 돌려주므로 동작한다.
    match /blocks/{blockId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
                    && request.resource.data.by == request.auth.uid
                    && request.auth.uid in request.resource.data.users;
      // 차단은 고쳐 쓰는 게 아니라 만들거나 지우는 것이다. 푸는 건 만든 사람만.
      allow update: if false;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // ===== 신고 (2026-08-14, 애플 심사 1.2) =====
    // 문서 ID = `종류_대상_신고자` → 한 사람이 같은 대상을 여러 번 신고해도 1건으로 남는다.
    // 그래서 '서로 다른 3명이면 자동 숨김'이 문서 수만으로 성립한다.
    // ★읽기는 관리자만 — 신고자가 누구인지는 신고당한 사람에게 절대 보이면 안 된다.
    //   (대상 글의 reportedBy 는 공개지만 그건 좋아요 likedBy 와 같은 수준의 노출이다)
    match /userReports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      // 내가 낸 신고는 사유를 고쳐 다시 낼 수 있다(setDoc 이 update 로 판정되는 경우).
      allow update: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ===== 센터 체크인 (도감·스탬프) =====
    // 문서 ID = {uid}_{centerId}_{yyyymmdd} → 하루 1회가 ID로 자연 강제됨
    match /checkins/{checkinId} {
      // ★읽기를 **비로그인에게도** 연다(대표 2026-08-12).
      //   콜드스타트 링크로 처음 온 사람에게 지도의 '오늘 체크인한 머피들'이 텅 비어 있었다.
      //   "여기 사람이 있다"가 가입 이유인데 그걸 못 보여주면 링크를 뿌리는 의미가 없다.
      //   ※쓰기는 그대로 본인만. 화면에서는 눌러도 못 들어가고 가입 화면으로 보낸다.
      //   ※공개되는 값 = 누가·어느 센터·언제·스탬프 사진. feed/bamboo/users 도 이미 공개읽기다.
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && checkinId.matches(request.auth.uid + '_.*');
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;   // 스탬프 사진 추가용
      allow delete: if false;                          // 인증 기록은 삭제 불가(경제의 기반)
    }

    // ===== 크루 및 모든 서브컬렉션 =====
    match /crews/{crewId} {
      // ★크루는 휴면이다(2026-07-20 스쿼드로 대체). 코드만 남겨 두고 새로 만들지 않는다.
      //   그런데 `delete: if signedIn()` 이라 **로그인만 하면 아무나 남의 크루를 지울 수** 있었다.
      //   운영자 검증을 클라이언트가 하고 있었다는 뜻이다(2026-08-25 점검).
      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn();        // 가입/멤버 변경 — 휴면이라 더 조이지 않는다
      allow delete: if isAdmin();

      match /schedules/{scheduleId} {
        allow read: if true;
        allow write: if signedIn();

        match /applicants/{applicantId} {
          allow read: if signedIn();
          allow write: if signedIn();
        }
      }

      match /posts/{postId} {
        allow read: if true;
        allow create: if signedIn();
        allow update: if signedIn();
        allow delete: if ownsDoc() || isAdmin();

        match /comments/{commentId} {
          allow read: if true;
          allow create: if signedIn();
          allow delete: if ownsDoc() || isAdmin();
        }
      }

      match /photos/{photoId} {
        allow read: if true;
        allow create: if signedIn();
        allow delete: if ownsDoc() || isAdmin();
      }

      match /chat/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn();
      }

      match /treasury/{entryId} {
        allow read: if signedIn();
        allow write: if signedIn();
      }

      match /feed/{postId} {
        allow read: if true;
        allow create: if signedIn();
        allow update: if signedIn();
        allow delete: if ownsDoc() || isAdmin();
      }
    }

    // ===== 즉석 스쿼드 (벙주 시스템) =====
    match /squads/{squadId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      // 참가 트랜잭션(memberUids)·출석코드·상태전이 — P0는 로그인 게이트, P2에서 Functions로 조임
      // ★2026-08-25 — `update: if signedIn()` 이라 아무나 남의 스쿼드 제목·장소·시간·회비를
      //   바꾸거나 스쿼드장을 자기로 바꿔치기할 수 있었다.
      //   멤버가 정상적으로 건드리는 값들(출석·입금 표시 등)은 그대로 두고,
      //   **스쿼드의 정체성에 해당하는 필드만** 스쿼드장·관리자로 잠근다.
      allow update: if signedIn() && (
          resource.data.hostUid == request.auth.uid || isAdmin()
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(
               ['hostUid', 'title', 'location', 'scheduledAt', 'capacity',
                'feeAmount', 'status', 'notice', 'staff'])
      );
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      // 멤버 문서 = 본인 or 벙주 or **운영진(staff)**  (승인/입금 토글)
      // ★운영진 추가 (대표 8-14) — 근방단 정기모임은 20명이 한꺼번에 들어오는데
      //   승인을 벙주 혼자 하면 현장에서 벙주가 폰만 붙들고 있게 된다.
      //   운영진은 벙주가 직접 지정한 사람이고(staff 플래그는 벙주만 켤 수 있다),
      //   그 스쿼드 안에서만 권한을 갖는다.
      // ★exists() 로 먼저 확인한다 — 멤버 문서가 없는 사람이 부르면 get() 이 터져서
      //   규칙 전체가 거부로 떨어진다. 필드도 get('staff', false) 로 기본값을 준다.
      match /members/{memberId} {
        allow read: if true;
        allow write: if signedIn() && (request.auth.uid == memberId
                     || get(/databases/$(database)/documents/squads/$(squadId)).data.hostUid == request.auth.uid
                     || (exists(/databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid))
                         && get(/databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid)).data.get('staff', false) == true));
      }

      // 스쿼드 톡 (sys 메시지는 uid=null 허용)
      // ★읽기 공개 — 단, **필드 말풍선만** 보여주기 위한 것이다 (대표 2026-08-14).
      //   8-12 에 참가자만으로 닫았던 이유는 "벙 대화가 밖에서 구경거리가 되면 안 된다" 였다.
      //   그 결정은 **톡 방(전체 로그)** 에 대한 것이고, 지금 여는 것은 그것과 다르다:
      //     · 필드 말풍선 = 잠깐 떴다 사라지는 한 줄. 콜드유저에게 '지금 사람이 활동 중'을 보여준다
      //     · 톡 방 = 지난 대화 전부. **UI 에서 참가자만** 들어갈 수 있게 그대로 잠가 둔다
      //   그래서 비참가자 구독은 앱에서 limit(1) 로 걸어 **과거 로그를 아예 안 받아온다.**
      // ★삭제는 **벙주도** 할 수 있다 — 벙주가 지난 대화를 정리하는 버튼이 생겼다(sqTalkClear).
      //   예전엔 관리자만이라 벙주가 자기 벙 기록도 못 지웠다.
      match /chat/{msgId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 200
                      && (request.resource.data.uid == request.auth.uid
                          || (request.resource.data.sys == true && request.resource.data.uid == null));
        allow update: if false;
        allow delete: if isAdmin()
                      || (signedIn()
                          && get(/databases/$(database)/documents/squads/$(squadId)).data.hostUid == request.auth.uid);
      }
    }

    // ===== 센터 (헬스장) =====
    match /centers/{centerId} {
      allow read: if true;
      allow create: if signedIn();
      // 관리자 편집 + 별점 재계산(rating/reviews) 비소유자 업데이트 허용
      allow update: if signedIn();
      allow delete: if isAdmin();

      // 별점/리뷰 (문서 ID = 작성자 uid)
      match /ratings/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // ===== 센터 수다방 (도장 찍은 머피 전용 톡 — 자격은 클라이언트 게이트, 베타) =====
    match /centerTalk/{centerId}/msgs/{msgId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 200;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ===== 리뷰 신고 (관리자만 열람) =====
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ===== 센터 정보 수정 요청 (관리자만 열람) =====
    match /centerEditRequests/{reqId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ===== 베타 피드백 (murpy.app/survey · 관리자만 열람) =====
    // ★create 를 로그인으로 막으면 안 된다 — '로그인 자체가 안 된다'는 제보를 못 받는다.
    //   대신 reports/centerEditRequests 와 같은 모양으로 읽기는 관리자만.
    match /feedback/{fbId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 4000;
      allow update, delete: if isAdmin();
    }

    // ===== 스쿼드 광고 카드 (관리자가 올리는 슬라이드) =====
    // 읽기는 전부 공개 — 로그인 안 한 콜드유저에게 보여주는 게 목적이라 막으면 안 된다.
    // 쓰기는 관리자만. 여기 뚫리면 앱 첫 화면에 아무 이미지나 걸린다.
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== 알림 =====
    match /notifications/{notifId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    // ===== 1:1 채팅 =====
    match /chats/{chatId} {
      allow read, write: if signedIn();

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }
  }
}
