{
  "rules": {
    ".read": false,
    ".write": false,
    "squadRooms": {
      "$sid": {
        "players": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "quiz": {
          ".read": true,
          ".write": "auth != null && (!data.exists() || data.child('host').val() == auth.uid || data.child('join').child(auth.uid).exists() || !newData.exists() || newData.child('st').val() == 'end')",
          "join": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      }
    },
    "plaza": {
      "shout": {
        ".read": "auth != null",
        "$mid": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() == auth.uid",
          ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 60 && newData.child('nick').isString() && newData.child('nick').val().length <= 24"
        }
      },
      "chat": {
        "$field": {
          ".read": "auth != null",
          "$mid": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() == auth.uid",
            ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 120 && newData.child('nick').isString() && newData.child('nick').val().length <= 24"
          }
        }
      }
    },
    "rv": {
      "$page": {
        ".read": "auth != null",
        "$slot": {
          ".write": true,
          ".validate": "newData.isString() && newData.val().length <= 24"
        }
      }
    },
    "roomLive": {
      "$owner": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $owner)"
          }
        },
        "kick": {
          "$uid": {
            ".write": "auth != null && auth.uid == $owner"
          }
        },
        "chat": {
          ".write": "auth != null && auth.uid == $owner && !newData.exists()",
          "$mid": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() == auth.uid",
            ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 200 && newData.child('nick').isString() && newData.child('nick').val().length <= 24"
          }
        },
        "jam": {
          "open": {
            ".write": "auth != null && auth.uid == $owner"
          },
          "px": {
            ".write": "auth != null"
          }
        },
        "pets": {
          ".write": "auth != null && auth.uid == $owner"
        }
      }
    }
  }
}
