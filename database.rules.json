{
  "rules": {
    ".read": false,
    ".write": false,
    "squadRooms": {
      "$sid": {
        "players": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "roomLive": {
      "$owner": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $owner)"
          }
        },
        "kick": {
          "$uid": {
            ".write": "auth != null && auth.uid == $owner"
          }
        },
        "chat": {
          ".write": "auth != null"
        },
        "jam": {
          "open": {
            ".write": "auth != null && auth.uid == $owner"
          },
          "px": {
            ".write": "auth != null"
          }
        },
        "pets": {
          ".write": "auth != null && auth.uid == $owner"
        }
      }
    }
  }
}
