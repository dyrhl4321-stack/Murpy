rules_version = '2';

// Firebase Storage 규칙 — 사진 업로드(2026-08-25, imgBB 한도 초과로 급히 이전)
//
// ★사진 URL 은 피드·프로필·대숲에 그대로 <img src> 로 박힌다. 그래서 **읽기는 공개**여야 한다.
//   비가입자도 피드를 보므로 로그인을 요구하면 사진이 전부 깨진다.
// ★쓰기는 본인 폴더에만. 남의 폴더에 못 올린다.
// ★크기·형식을 규칙에서 막는다 — 클라이언트만 믿으면 누가 8GB 짜리를 올려 요금을 태울 수 있다.
service firebase.storage {
  match /b/{bucket}/o {

    // uploads/{uid}/... — 앱이 올리는 모든 사진
    match /uploads/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024        // 8MB
                   && request.resource.contentType.matches('image/.*');
      // 지우는 건 본인만 (프로필 사진 교체 등)
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 그 밖의 경로는 전부 막는다 — 열어 둘 이유가 없다
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
